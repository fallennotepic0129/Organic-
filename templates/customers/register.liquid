<section class="account">
  <div class="container container--narrow">
    <div class="card account__card">
      <h1 class="h2">Create account</h1>
      {%- form 'create_customer', class: 'form' -%}
        {{ form.errors | default_errors }}
        <div class="form__row">
          <label class="field"><span>First name</span><input type="text" name="customer[first_name]" autocomplete="given-name"></label>
          <label class="field"><span>Last name</span><input type="text" name="customer[last_name]" autocomplete="family-name"></label>
        </div>
        <label class="field"><span>Email</span><input type="email" name="customer[email]" autocomplete="email" required></label>
        <label class="field"><span>Password</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
        <button type="submit" class="btn btn--ink btn--block"><span class="btn__label">Create account</span></button>
      {%- endform -%}
    </div>
  </div>
</section>
