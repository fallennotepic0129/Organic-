<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..800,0..100;1,9..144,300..800,0..100&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
      :root {
        --c-cream: {{ settings.color_cream }};
        --c-paper: {{ settings.color_paper }};
        --c-ink: {{ settings.color_ink }};
        --c-gold: {{ settings.color_gold }};
        --c-gold-deep: {{ settings.color_gold_deep }};
        --c-dark: {{ settings.color_dark }};
        --c-amber: {{ settings.color_amber }};
        --c-leaf: {{ settings.color_leaf }};
        --logo-width: {{ settings.logo_width }}px;
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.MD = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 0 | times: 100 }},
        whatsapp: {{ settings.whatsapp_number | remove: '+' | remove: ' ' | json }},
        motion: {
          smooth: {{ settings.enable_smooth_scroll | json }},
          cursor: {{ settings.enable_cursor | json }},
          preloader: {{ settings.enable_preloader | json }}
        },
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          adding: {{ 'products.adding' | t | json }},
          added: {{ 'products.added' | t | json }}
        }
      };
    </script>
    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'SplitText.min.js' | asset_url }}" defer></script>
    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'motion.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="MainContent" class="main" role="main">
      {{ content_for_layout }}
    </main>
    {%- if settings.enable_grain -%}<div class="grain" aria-hidden="true"></div>{%- endif -%}
  </body>
</html>
