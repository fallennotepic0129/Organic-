{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign uid = 'pdp-' | append: section.id
  assign uid_thumb = uid | append: 't'
  assign uid_sticky = uid | append: 's'
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
-%}
<section class="pdp" data-scene="pdp" data-product-section>
  <div class="pdp__grid container">
    <div class="pdp__media">
      <div class="pdp__stage" data-pdp-stage>
        <div class="pdp__halo" aria-hidden="true"></div>
        <svg class="pdp__orbit" viewBox="0 0 400 400" aria-hidden="true" data-pdp-orbit>
          <defs><path id="{{ uid }}-orbit" d="M200 200 m-170 0 a170 170 0 1 1 340 0 a170 170 0 1 1 -340 0"/></defs>
          <text><textPath href="#{{ uid }}-orbit">{{ section.settings.orbit_text }} {{ section.settings.orbit_text }} </textPath></text>
        </svg>
        <div class="pdp__particles" aria-hidden="true">
          {%- for i in (1..14) -%}
            <span style="--x: {{ i | times: 61 | modulo: 100 }}%; --y: {{ i | times: 29 | modulo: 100 }}%; --s: {{ i | modulo: 4 | plus: 4 }}px; --d: {{ i | modulo: 6 | plus: 5 }}s; --delay: -{{ i | modulo: 5 }}s"></span>
          {%- endfor -%}
        </div>
        <div class="pdp__visual" data-pdp-visual>
          {% render 'product-visual', product: product, uid: uid %}
        </div>
        <div class="pdp__photo" data-pdp-photo hidden></div>
      </div>

      {%- if product.media.size > 0 -%}
        <div class="pdp__thumbs" role="list">
          <button type="button" class="pdp__thumb is-active" data-pdp-thumb="visual" aria-label="Illustration" role="listitem">
            {% render 'product-visual', product: product, uid: uid_thumb, label: false %}
          </button>
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button type="button" class="pdp__thumb" data-pdp-thumb="{{ media | image_url: width: 1400 }}" data-alt="{{ media.alt | escape }}" aria-label="View image {{ forloop.index }}" role="listitem">
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt }}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp__info" data-pdp-info>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'title' -%}
            <nav class="crumbs" aria-label="Breadcrumb" {{ block.shopify_attributes }}>
              <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><a href="{{ routes.all_products_collection_url }}">Shop</a>
            </nav>
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            <h1 class="pdp__title" data-split>{{ product.title }}</h1>

          {%- when 'rating' -%}
            <a class="pdp__rating" href="#reviews" {{ block.shopify_attributes }}>
              {%- if rating != blank -%}
                {% render 'stars', rating: rating.rating, count: rating_count, size: 16 %}
              {%- else -%}
                {% render 'stars', rating: 0, size: 16 %}<span class="stars__count">Be the first to review</span>
              {%- endif -%}
            </a>

          {%- when 'price' -%}
            <div class="pdp__price" {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current %}
              {%- if block.settings.note != blank -%}<p class="pdp__price-note">{{ block.settings.note }}</p>{%- endif -%}
            </div>

          {%- when 'text' -%}
            <div class="pdp__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index0 -%}
                  <fieldset class="variant-picker__group">
                    <legend>{{ option.name }}: <span data-option-label="{{ option_index }}">{{ option.selected_value }}</span></legend>
                    <div class="pills">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign pill_price = nil
                          if product.options.size == 1
                            for v in product.variants
                              if v.option1 == value
                                assign pill_price = v.price
                              endif
                            endfor
                          endif
                        -%}
                        <label class="pill">
                          <input type="radio" name="{{ option.name | escape }}-{{ section.id }}" value="{{ value | escape }}" data-option-index="{{ option_index }}" {% if option.selected_value == value %}checked{% endif %}>
                          <span class="pill__body">
                            <span class="pill__value">{{ value }}</span>
                            {%- if pill_price != nil -%}<span class="pill__price">{{ pill_price | money_without_trailing_zeros }}</span>{%- endif -%}
                          </span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-variants-json>
                  [{%- for v in product.variants -%}{"id":{{ v.id }},"available":{{ v.available | json }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }},"options":{{ v.options | json }},"title":{{ v.title | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
                </script>
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'buy__form', data-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
                <div class="buy__row">
                  <div class="qty" data-qty>
                    <button type="button" data-qty-step="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus', size: 16 %}</button>
                    <label class="visually-hidden" for="Qty-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                    <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                    <button type="button" data-qty-step="1" aria-label="Increase quantity">{% render 'icon', name: 'plus', size: 16 %}</button>
                  </div>
                  <button type="submit" class="btn btn--ink btn--grow" data-add-button data-magnetic {% unless current.available %}disabled{% endunless %}>
                    <span class="btn__label" data-add-label>{% if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
                    <span class="btn__price" data-add-price>· {{ current.price | money_without_trailing_zeros }}</span>
                  </button>
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="buy__dynamic">{{ form | payment_button }}</div>
                {%- endif -%}
              {%- endform -%}
              {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' -%}
              {%- if block.settings.show_whatsapp and wa_number != blank -%}
                <button type="button" class="btn btn--whatsapp btn--block" data-whatsapp-order data-product-title="{{ product.title | escape }}" data-product-url="{{ shop.url }}{{ product.url }}">
                  {% render 'icon', name: 'whatsapp', size: 18 %}<span class="btn__label">{{ 'products.order_on_whatsapp' | t }}</span>
                </button>
              {%- endif -%}
              {%- if settings.cod_note != blank -%}<p class="buy__cod">{% render 'icon', name: 'cash', size: 16 %} {{ settings.cod_note }}</p>{%- endif -%}
            </div>

          {%- when 'trust' -%}
            <ul class="trust" {{ block.shopify_attributes }}>
              {%- if block.settings.item_1 != blank -%}<li>{% render 'icon', name: 'flask', size: 22 %}<span>{{ block.settings.item_1 }}</span></li>{%- endif -%}
              {%- if block.settings.item_2 != blank -%}<li>{% render 'icon', name: 'shield', size: 22 %}<span>{{ block.settings.item_2 }}</span></li>{%- endif -%}
              {%- if block.settings.item_3 != blank -%}<li>{% render 'icon', name: 'truck', size: 22 %}<span>{{ block.settings.item_3 }}</span></li>{%- endif -%}
              {%- if block.settings.item_4 != blank -%}<li>{% render 'icon', name: 'refresh', size: 22 %}<span>{{ block.settings.item_4 }}</span></li>{%- endif -%}
            </ul>

          {%- when 'delivery' -%}
            <p class="delivery" data-delivery data-min="{{ settings.delivery_min_days }}" data-max="{{ settings.delivery_max_days }}" {{ block.shopify_attributes }}>
              {% render 'icon', name: 'truck', size: 18 %}
              <span>Order today — arrives <strong data-delivery-range>in {{ settings.delivery_min_days }}–{{ settings.delivery_max_days }} working days</strong></span>
            </p>

          {%- when 'lab_report' -%}
            <a class="lab-link" href="{{ block.settings.link | default: '/pages/lab-reports' }}" {{ block.shopify_attributes }}>
              <span class="lab-link__icon">{% render 'icon', name: 'document', size: 20 %}</span>
              <span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></span>
              {% render 'icon', name: 'arrow-up-right', size: 16 %}
            </a>

          {%- when 'collapsible' -%}
            <details class="accordion accordion--pdp" data-accordion {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                <span>{% render 'icon', name: block.settings.icon, size: 18 %} {{ block.settings.heading }}</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="accordion__content rte">
                {%- if block.settings.source == 'description' -%}
                  {{ product.description }}
                {%- else -%}
                  {{ block.settings.content }}
                {%- endif -%}
              </div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="sticky-buy" data-sticky-buy aria-hidden="true">
    <div class="sticky-buy__inner">
      <div class="sticky-buy__jar" aria-hidden="true">{% render 'product-visual', product: product, uid: uid_sticky, label: false %}</div>
      <div class="sticky-buy__info">
        <p class="sticky-buy__title">{{ product.title }}</p>
        <p class="sticky-buy__price"><span data-sticky-variant>{% unless product.has_only_default_variant %}{{ current.title }} · {% endunless %}</span><span data-sticky-price>{{ current.price | money_without_trailing_zeros }}</span></p>
      </div>
      <button type="submit" form="{{ form_id }}" class="btn btn--ink" data-add-button tabindex="-1" {% unless current.available %}disabled{% endunless %}>
        <span class="btn__label" data-add-label>{% if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
      </button>
    </div>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 300 | json }},
      "url": {{ shop.url | append: product.url | json }},
      "brand": { "@type": "Brand", "name": {{ settings.brand_name | default: shop.name | json }} },
      {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
      "offers": [
        {%- for v in product.variants -%}
          {
            "@type": "Offer",
            "sku": {{ v.sku | json }},
            "name": {{ v.title | json }},
            "price": {{ v.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "availability": "http://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
            "url": {{ shop.url | append: v.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "class": "section-main-product",
  "settings": [
    { "type": "text", "id": "orbit_text", "label": "Rotating badge text", "default": "LAB TESTED · 100% PURE · SMALL BATCH ·" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1, "settings": [ { "type": "text", "id": "eyebrow", "label": "Eyebrow" } ] },
    { "type": "rating", "name": "Star rating", "limit": 1, "settings": [ { "type": "paragraph", "content": "Uses Shopify's standard review metafields, filled automatically by Judge.me and most review apps." } ] },
    { "type": "price", "name": "Price", "limit": 1, "settings": [ { "type": "text", "id": "note", "label": "Note under price", "default": "Price includes packaging. Delivery calculated at checkout." } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Short, honest description.</p>" } ] },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show \"Buy it now\" button", "default": true },
      { "type": "checkbox", "id": "show_whatsapp", "label": "Show \"Order on WhatsApp\"", "default": true }
    ] },
    { "type": "trust", "name": "Trust badges", "limit": 1, "settings": [
      { "type": "text", "id": "item_1", "label": "Badge 1", "default": "Lab tested every batch" },
      { "type": "text", "id": "item_2", "label": "Badge 2", "default": "PFA licensed" },
      { "type": "text", "id": "item_3", "label": "Badge 3", "default": "Free delivery over Rs. 5,000" },
      { "type": "text", "id": "item_4", "label": "Badge 4", "default": "Damaged? We replace it" }
    ] },
    { "type": "delivery", "name": "Delivery estimate", "limit": 1, "settings": [] },
    { "type": "lab_report", "name": "Lab report link", "limit": 1, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "View the lab report" },
      { "type": "text", "id": "text", "label": "Text", "default": "Independent test results for this product" },
      { "type": "url", "id": "link", "label": "Link" }
    ] },
    { "type": "collapsible", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
      { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
        { "value": "leaf", "label": "Leaf" }, { "value": "flask", "label": "Flask" }, { "value": "truck", "label": "Truck" },
        { "value": "heart", "label": "Heart" }, { "value": "drop", "label": "Drop" }, { "value": "mountain", "label": "Mountain" },
        { "value": "flame", "label": "Flame" }, { "value": "shield", "label": "Shield" }
      ] },
      { "type": "select", "id": "source", "label": "Content", "default": "custom", "options": [ { "value": "description", "label": "Product description" }, { "value": "custom", "label": "Custom text" } ] },
      { "type": "richtext", "id": "content", "label": "Custom text" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ] }
  ]
}
{% endschema %}
