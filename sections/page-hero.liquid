{%- liquid
  assign uid_g = 'phg-' | append: section.id
  assign uid_s = 'phs-' | append: section.id
-%}
<section class="page-hero page-hero--{{ section.settings.tone }}" data-scene="page-hero" {% if section.settings.tone == 'dark' %}data-header-theme="dark"{% endif %}>
  <div class="container page-hero__grid">
    <div class="page-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="page-hero__title" data-split>{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.text != blank -%}<p class="page-hero__text" data-reveal>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if section.settings.art != 'none' -%}
      <div class="page-hero__art" aria-hidden="true" data-parallax="-0.12">
        {%- if section.settings.art == 'ghee' or section.settings.art == 'both' -%}
          <div class="page-hero__jar page-hero__jar--ghee" data-float>{% render 'jar-ghee', uid: uid_g %}</div>
        {%- endif -%}
        {%- if section.settings.art == 'shilajit' or section.settings.art == 'both' -%}
          <div class="page-hero__jar page-hero__jar--shilajit" data-float>{% render 'jar-shilajit', uid: uid_s %}</div>
        {%- endif -%}
        {%- if section.settings.art == 'seal' -%}
          <div class="page-hero__seal" data-float>{% render 'wax-seal', uid: uid_s, mark: 'MD', text: 'LAB TESTED · CERTIFIED · PURE · ' %}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "tag": "div",
  "class": "section-page-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "select", "id": "art", "label": "Illustration", "default": "both", "options": [
      { "value": "none", "label": "None" }, { "value": "ghee", "label": "Ghee jar" }, { "value": "shilajit", "label": "Shilajit jar" },
      { "value": "both", "label": "Both jars" }, { "value": "seal", "label": "Wax seal" }
    ] },
    { "type": "select", "id": "tone", "label": "Background", "default": "cream", "options": [ { "value": "cream", "label": "Cream" }, { "value": "dark", "label": "Dark" } ] }
  ],
  "presets": [ { "name": "Page hero" } ]
}
{% endschema %}
