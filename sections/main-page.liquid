<section class="page-content">
  <div class="container container--narrow">
    {%- if section.settings.show_title -%}<h1 class="h2" data-split>{{ page.title }}</h1>{%- endif -%}
    <div class="rte" data-reveal>{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "tag": "div",
  "class": "section-main-page",
  "settings": [ { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true } ]
}
{% endschema %}
