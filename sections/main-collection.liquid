<section class="collection">
  <div class="container">
    <div class="collection__head">
      <p class="eyebrow">Shop</p>
      <h1 class="h2" data-split>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="collection__desc rte" data-reveal>{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- paginate collection.products by 24 -%}
      <div class="collection__grid">
        {%- for product in collection.products -%}
          {%- assign uid = 'col-' | append: forloop.index -%}
          <div data-reveal>{% render 'product-tile', product: product, uid: uid %}</div>
        {%- else -%}
          <p class="collection__empty">No products here yet.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "tag": "div", "class": "section-main-collection", "settings": [] }
{% endschema %}
