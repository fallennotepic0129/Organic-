{%- assign uid = 'st-' | append: section.id -%}
<section class="story story--{{ section.settings.tone }}{% if section.settings.reverse %} story--reverse{% endif %}" {% if section.settings.tone == 'dark' %}data-header-theme="dark"{% endif %}>
  <div class="container story__grid">
    <div class="story__media" data-reveal>
      {%- if section.settings.image != blank -%}
        <div class="story__img" data-parallax-img>
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600, 900, 1200, 1400' }}
        </div>
      {%- else -%}
        <div class="story__art">
          {%- if section.settings.art == 'shilajit' -%}{% render 'jar-shilajit', uid: uid %}{%- elsif section.settings.art == 'churn' -%}{% render 'bilona-art', art: 'churn', uid: uid %}{%- else -%}{% render 'jar-ghee', uid: uid %}{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="story__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2" data-split>{{ section.settings.heading }}</h2>
      <div class="story__text rte" data-reveal>{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--{% if section.settings.tone == 'dark' %}gold{% else %}ink{% endif %}" href="{{ section.settings.button_link }}" data-magnetic><span class="btn__label">{{ section.settings.button_label }}</span>{% render 'icon', name: 'arrow-right', size: 16 %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "class": "section-story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "art", "label": "Illustration when no image", "default": "ghee", "options": [ { "value": "ghee", "label": "Ghee jar" }, { "value": "shilajit", "label": "Shilajit jar" }, { "value": "churn", "label": "Churning pot" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "It started with our grandmother's kitchen." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "select", "id": "tone", "label": "Background", "default": "cream", "options": [ { "value": "cream", "label": "Cream" }, { "value": "paper", "label": "Paper" }, { "value": "dark", "label": "Dark" } ] }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
