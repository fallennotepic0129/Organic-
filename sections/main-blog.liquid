<section class="blog">
  <div class="container">
    <p class="eyebrow">Journal</p>
    <h1 class="h2" data-split>{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      <div class="blog__grid">
        {%- for article in blog.articles -%}
          <a class="blog-card" href="{{ article.url }}" data-reveal>
            <div class="blog-card__media">
              {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}<span class="blog-card__ph" aria-hidden="true">{% render 'icon', name: 'leaf', size: 40 %}</span>{%- endif -%}
            </div>
            <p class="blog-card__date">{{ article.published_at | date: '%d %b %Y' }}</p>
            <h2 class="blog-card__title">{{ article.title }}</h2>
            <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "tag": "div", "class": "section-main-blog", "settings": [] }
{% endschema %}
