<section class="cart-page">
  <div class="container">
    <h1 class="h2" data-split>{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty">
        <div class="cart-page__jar">{% render 'jar-ghee', uid: 'cart-empty', level: 0.06, label: false %}</div>
        <p>{{ 'cart.empty' | t }}</p>
        <a class="btn btn--ink" href="{{ routes.all_products_collection_url }}" data-magnetic><span class="btn__label">{{ 'cart.continue' | t }}</span>{% render 'icon', name: 'arrow-right', size: 16 %}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page__grid">
        <ul class="cart-page__items">
          {%- for item in cart.items -%}
            {%- assign li_uid = 'cp-' | append: forloop.index -%}
            <li class="line-item line-item--lg">
              <a class="line-item__media" href="{{ item.url }}">
                {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: alt: item.title, loading: 'lazy' }}{%- else -%}{% render 'product-visual', product: item.product, uid: li_uid, label: false %}{%- endif -%}
              </a>
              <div class="line-item__info">
                <a class="line-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="line-item__variant">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="line-item__unit">{{ item.final_price | money_without_trailing_zeros }} each</p>
              </div>
              <label class="qty-input">
                <span class="visually-hidden">{{ 'products.quantity' | t }}</span>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
              </label>
              <span class="line-item__price">{{ item.final_line_price | money_without_trailing_zeros }}</span>
              <a class="line-item__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </li>
          {%- endfor -%}
        </ul>
        <aside class="cart-page__summary card">
          <label class="field">
            <span>Order note (optional)</span>
            <textarea name="note" rows="3" placeholder="Delivery instructions, gift message…">{{ cart.note }}</textarea>
          </label>
          <div class="drawer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_without_trailing_zeros }}</strong></div>
          <p class="drawer__note">{% render 'icon', name: 'cash', size: 16 %} {{ settings.cod_note }} · {{ 'cart.taxes_note' | t }}</p>
          <button type="submit" name="checkout" class="btn btn--ink btn--block" data-magnetic><span class="btn__label">{{ 'cart.checkout' | t }}</span>{% render 'icon', name: 'arrow-right', size: 16 %}</button>
          <button type="submit" name="update" class="btn btn--outline btn--block"><span class="btn__label">Update cart</span></button>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "tag": "div", "class": "section-main-cart", "settings": [] }
{% endschema %}
