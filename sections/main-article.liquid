<article class="article">
  <div class="container container--narrow">
    <p class="eyebrow">{{ article.published_at | date: '%d %B %Y' }}</p>
    <h1 class="h2" data-split>{{ article.title }}</h1>
    {%- if article.image -%}
      <div class="article__image">{{ article.image | image_url: width: 1600 | image_tag: alt: article.title }}</div>
    {%- endif -%}
    <div class="rte" data-reveal>{{ article.content }}</div>
    <a class="link-underline" href="{{ blog.url }}">← Back to {{ blog.title }}</a>
  </div>
</article>

{% schema %}
{ "name": "Article", "tag": "div", "class": "section-main-article", "settings": [] }
{% endschema %}
