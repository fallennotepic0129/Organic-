<section class="faq">
  <div class="container faq__grid">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2" data-split>{{ section.settings.heading }}</h2>
      <div class="faq__help" data-reveal>
        <p>{{ section.settings.help_text }}</p>
        {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' -%}
        {%- if wa_number != blank -%}
          <a class="btn btn--whatsapp" href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener" data-magnetic>
            {% render 'icon', name: 'whatsapp', size: 18 %}<span class="btn__label">Chat on WhatsApp</span>
          </a>
        {%- endif -%}
      </div>
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" data-accordion {{ block.shopify_attributes }}>
          <summary class="accordion__summary"><span>{{ block.settings.question }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you'd ask us at the farm gate." },
    { "type": "textarea", "id": "help_text", "label": "Help text", "default": "Can't find your answer? We usually reply on WhatsApp within the hour." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Do you offer cash on delivery?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes — cash on delivery is available across Pakistan.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Do you offer cash on delivery?", "answer": "<p>Yes. Cash on Delivery is available across Pakistan. You can also pay by bank transfer, JazzCash or Easypaisa.</p>" } },
        { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>Most orders arrive in 2–5 working days. Major cities are usually faster. You'll get a tracking number by SMS/WhatsApp once your parcel ships.</p>" } },
        { "type": "question", "settings": { "question": "What makes bilona ghee different?", "answer": "<p>Bilona ghee is made from curd that is hand-churned into makhan, then slow-cooked. Most commercial ghee is made from cream. The bilona method gives a grainy (danedar) texture, a deeper aroma and keeps more of the milk's goodness.</p>" } },
        { "type": "question", "settings": { "question": "How can I tell if desi ghee is pure?", "answer": "<p>Pure bilona ghee sets with a grainy (danedar) texture, melts quickly on a warm hand, smells nutty and sweet, and leaves no oily film or chemical smell. Every batch of ours is also lab tested — see the Lab Reports page.</p>" } },
        { "type": "question", "settings": { "question": "How should I store desi ghee?", "answer": "<p>Keep the jar in a cool, dry place with the lid closed and always use a dry spoon. Pure ghee keeps for months at room temperature — no fridge needed.</p>" } },
        { "type": "question", "settings": { "question": "Can I return or exchange an order?", "answer": "<p>If your jar arrives damaged or isn't right, message us within 48 hours of delivery with a photo and we'll replace it. See our refund policy for details.</p>" } }
      ]
    }
  ]
}
{% endschema %}
