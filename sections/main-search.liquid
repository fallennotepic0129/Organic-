<section class="search-page">
  <div class="container">
    <h1 class="h2">{{ 'general.search' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <label class="visually-hidden" for="SearchInput">{{ 'general.search' | t }}</label>
      <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search ghee, shilajit…">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn btn--ink">{% render 'icon', name: 'search', size: 18 %}<span class="btn__label">{{ 'general.search' | t }}</span></button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="search-page__count">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ search.terms }}”</p>
        <div class="collection__grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- assign uid = 'sr-' | append: forloop.index -%}
              {% render 'product-tile', product: item, uid: uid %}
            {%- else -%}
              <a class="search-page__item card" href="{{ item.url }}"><strong>{{ item.title }}</strong></a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "tag": "div", "class": "section-main-search", "settings": [] }
{% endschema %}
