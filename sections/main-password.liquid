<section class="password">
  <div class="password__inner">
    <div class="password__jar" data-float aria-hidden="true">{% render 'jar-ghee', uid: 'pw', level: 0.7 %}</div>
    <p class="eyebrow">{{ settings.brand_name | default: shop.name }}</p>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'footer__newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required aria-label="{{ 'newsletter.email' | t }}">
        <button type="submit" class="btn btn--gold"><span class="btn__label">Notify me</span></button>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary>Store owner? Enter password</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <input type="password" name="password" placeholder="Password" aria-label="Password">
        <button type="submit" class="btn btn--ink"><span class="btn__label">Enter</span></button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "div",
  "class": "section-password",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Something golden is coming." } ]
}
{% endschema %}
