<section class="duo" data-scene="duo">
  <div class="container">
    <div class="duo__head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2" data-split>{{ section.settings.heading }}</h2>
    </div>
    <div class="duo__grid">
      {%- assign uid_1 = 'duo1-' | append: section.id -%}
      {%- assign uid_2 = 'duo2-' | append: section.id -%}
      <div data-reveal>{% render 'product-tile', product: section.settings.product_1, uid: uid_1, tagline: section.settings.tagline_1, force: 'ghee' %}</div>
      <div data-reveal>{% render 'product-tile', product: section.settings.product_2, uid: uid_2, tagline: section.settings.tagline_2, force: 'shilajit' %}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product duo",
  "tag": "div",
  "class": "section-duo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two things. Done properly." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gold from the farm. Black gold from the mountains." },
    { "type": "product", "id": "product_1", "label": "Ghee product" },
    { "type": "text", "id": "tagline_1", "label": "Ghee tagline", "default": "Bilona desi ghee — hand-churned, wood-fire cooked." },
    { "type": "product", "id": "product_2", "label": "Shilajit product" },
    { "type": "text", "id": "tagline_2", "label": "Shilajit tagline", "default": "Pure resin from the cliffs of Gilgit-Baltistan." }
  ],
  "presets": [ { "name": "Product duo" } ]
}
{% endschema %}
