{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'cart', size: 20 %}
{%- endcomment -%}
{%- assign s = size | default: 20 -%}
<svg class="icon icon--{{ name }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'cart' -%}
      <path d="M5 7h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 7Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'menu' -%}
      <path d="M3 8h18M3 16h18"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17 17 7M8 7h9v9"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>
    {%- when 'leaf' -%}
      <path d="M5 19C5 10 11 5 20 4c-.5 9-5.5 15-14 15H5Z"/><path d="M5 19c3-4 6-6.5 10-8.5"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'cash' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/>
    {%- when 'flask' -%}
      <path d="M9 3h6M10 3v6L4.8 18a2 2 0 0 0 1.7 3h11a2 2 0 0 0 1.7-3L14 9V3"/><path d="M7.5 14h9"/>
    {%- when 'star' -%}
      <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" fill="currentColor" stroke="none"/>
    {%- when 'whatsapp' -%}
      <path d="M3.5 20.5 4.8 16A8.6 8.6 0 1 1 8 19.2l-4.5 1.3Z"/><path d="M9 8.5c0 3.6 2.9 6.5 6.5 6.5l1-1.6-2.2-1-1 .9a5 5 0 0 1-2.6-2.6l.9-1-1-2.2L9 8.5Z" fill="currentColor" stroke="none"/>
    {%- when 'phone' -%}
      <path d="M5 3.5h3.5l1.5 4.5-2 1.3a11 11 0 0 0 6.7 6.7L16 14l4.5 1.5V19a2 2 0 0 1-2 2A15.5 15.5 0 0 1 3 5.5a2 2 0 0 1 2-2Z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>
    {%- when 'pin' -%}
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'drop' -%}
      <path d="M12 3.5s6.5 7 6.5 11.3a6.5 6.5 0 0 1-13 0C5.5 10.5 12 3.5 12 3.5Z"/>
    {%- when 'mountain' -%}
      <path d="m2.5 19.5 7-12 4.5 7.5 2.5-3.5 5 8H2.5Z"/><path d="m7.6 10.8 1.9 1.4 1.6-1.2"/>
    {%- when 'flame' -%}
      <path d="M12 21a6.5 6.5 0 0 0 6.5-6.5c0-4-3-6-4-10-2 2-3 3.5-3 6-1-1-1.5-2-1.5-3.5-2.5 2-4.5 4.8-4.5 7.5A6.5 6.5 0 0 0 12 21Z"/>
    {%- when 'award' -%}
      <circle cx="12" cy="9" r="6"/><path d="m8.5 14 -1.5 7 5-3 5 3-1.5-7"/>
    {%- when 'refresh' -%}
      <path d="M20 11a8 8 0 0 0-14.8-3.5M4 4v4h4M4 13a8 8 0 0 0 14.8 3.5M20 20v-4h-4"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor"/>
    {%- when 'facebook' -%}
      <path d="M14 8.5h2.5V5H14a4 4 0 0 0-4 4v2H7.5v3.5H10V21h3.5v-6.5H16l.5-3.5h-3v-1.5a1 1 0 0 1 1-1Z"/>
    {%- when 'tiktok' -%}
      <path d="M14 3.5v11.2a3.3 3.3 0 1 1-3.3-3.3"/><path d="M14 3.5c.4 2.6 2.3 4.5 5 4.8"/>
    {%- when 'youtube' -%}
      <rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9 5 3-5 3V9Z" fill="currentColor"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10A4.4 4.4 0 0 1 12 7.4 4.4 4.4 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/>
    {%- when 'sparkle' -%}
      <path d="M12 3c.6 4.6 3.4 7.4 8 8-4.6.6-7.4 3.4-8 8-.6-4.6-3.4-7.4-8-8 4.6-.6 7.4-3.4 8-8Z"/>
    {%- when 'document' -%}
      <path d="M7 3h7l4 4v14H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v4h4M9 12h7M9 16h5"/>
    {%- when 'quote' -%}
      <path d="M10 7H6a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h3v1a3 3 0 0 1-3 3M19 7h-4a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h3v1a3 3 0 0 1-3 3"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
