<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__inner">
    <div class="preloader__jar">
      {% render 'jar-ghee', uid: 'preloader', level: 0, stream: true, label: false %}
    </div>
    <p class="preloader__count"><span data-preloader-count>0</span><span class="preloader__pct">%</span></p>
  </div>
  <p class="preloader__brand">{{ settings.brand_name | default: shop.name }}</p>
</div>
