{%- comment -%}
  Large product tile with a code-drawn jar stage. Params: product, uid, tagline
{%- endcomment -%}
<article class="tile" data-tilt data-cursor="View">
  <a class="tile__link" href="{{ product.url | default: routes.all_products_collection_url }}" aria-label="{{ product.title | escape }}"></a>
  <div class="tile__stage" aria-hidden="true">
    <div class="tile__halo"></div>
    <div class="tile__jar" data-tilt-depth="40">
      {% render 'product-visual', product: product, uid: uid %}
    </div>
  </div>
  <div class="tile__body">
    <p class="eyebrow">From the farm</p>
    <h3 class="tile__title">{{ product.title | default: 'Product' }}</h3>
    {%- if tagline != blank -%}<p class="tile__tagline">{{ tagline }}</p>{%- endif -%}
    <div class="tile__meta">
      {%- if product != blank -%}{% render 'price', product: product, show_from: true %}{%- endif -%}
      {%- assign rating = product.metafields.reviews.rating.value -%}
      {%- if rating != blank -%}{% render 'stars', rating: rating.rating %}{%- endif -%}
    </div>
    <span class="tile__cta">Shop now {% render 'icon', name: 'arrow-up-right', size: 16 %}</span>
  </div>
</article>
