{%- comment -%}
  Hand-drawn glass jar of desi ghee, fully in SVG so it can be animated.
  Params:
    uid        – unique id prefix (required when more than one jar is on a page)
    level      – initial fill level 0..1 (default 1)
    stream     – include the pouring stream (hero)
    label      – show the label (default true)
    as_group   – output a <g> instead of a standalone <svg>
    title      – label title (default "Desi Ghee")
    subtitle   – label subtitle
{%- endcomment -%}
{%- liquid
  assign uid = uid | default: 'jg'
  assign level = level | default: 1
  assign ty = 1 | minus: level | times: 290
  assign title = title | default: 'Desi Ghee'
  assign subtitle = subtitle | default: 'Bilona · Hand-churned'
  assign show_label = true
  if label == false
    assign show_label = false
  endif
-%}
{%- capture jar_body -%}
<g class="jar__root" data-jar="ghee">
  <defs>
    <linearGradient id="{{ uid }}-ghee" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F7DE93"/>
      <stop offset=".35" stop-color="#E9B74E"/>
      <stop offset="1" stop-color="#B07A22"/>
    </linearGradient>
    <linearGradient id="{{ uid }}-gheeside" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8F5E15" stop-opacity=".55"/>
      <stop offset=".18" stop-color="#8F5E15" stop-opacity="0"/>
      <stop offset=".8" stop-color="#8F5E15" stop-opacity="0"/>
      <stop offset="1" stop-color="#6E460C" stop-opacity=".6"/>
    </linearGradient>
    <linearGradient id="{{ uid }}-surface" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFF1C2"/>
      <stop offset="1" stop-color="#F2CE72"/>
    </linearGradient>
    <linearGradient id="{{ uid }}-metal" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8C6420"/>
      <stop offset=".22" stop-color="#E9C77A"/>
      <stop offset=".45" stop-color="#B8892F"/>
      <stop offset=".7" stop-color="#F3D99A"/>
      <stop offset="1" stop-color="#7A5418"/>
    </linearGradient>
    <linearGradient id="{{ uid }}-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".55"/>
      <stop offset=".5" stop-color="#ffffff" stop-opacity=".12"/>
      <stop offset="1" stop-color="#ffffff" stop-opacity=".4"/>
    </linearGradient>
    <linearGradient id="{{ uid }}-stream" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#B98226"/>
      <stop offset=".45" stop-color="#FBE3A0"/>
      <stop offset="1" stop-color="#C9922F"/>
    </linearGradient>
    <clipPath id="{{ uid }}-clip">
      <path d="M84 70 L84 80 C84 94 54 98 54 124 L54 352 C54 370 67 382 88 382 L212 382 C233 382 246 370 246 352 L246 124 C246 98 216 94 216 80 L216 70 Z"/>
    </clipPath>
    <clipPath id="{{ uid }}-labelclip">
      <rect class="jar__label-mask" x="40" y="190" width="{% if show_label %}220{% else %}0{% endif %}" height="124"/>
    </clipPath>
  </defs>

  <ellipse class="jar__shadow" cx="150" cy="392" rx="118" ry="10" fill="#17120D" opacity=".18"/>

  {%- comment -%} back glass {%- endcomment -%}
  <path d="M82 62 L82 80 C82 92 52 96 52 122 L52 352 C52 372 66 384 88 384 L212 384 C234 384 248 372 248 352 L248 122 C248 96 218 92 218 80 L218 62 Z" fill="url(#{{ uid }}-glass)" opacity=".55"/>

  {%- if stream -%}
    <g class="jar__stream">
      <g class="jar__stream-inner">
        <rect x="143" y="-138" width="14" height="524" rx="7" fill="url(#{{ uid }}-stream)"/>
        <rect x="147" y="-138" width="2.4" height="524" rx="1.2" fill="#fff" opacity=".55"/>
      </g>
    </g>
  {%- endif -%}

  <g clip-path="url(#{{ uid }}-clip)">
    <g class="jar__fill" transform="translate(0 {{ ty }})">
      <rect x="30" y="104" width="240" height="300" fill="url(#{{ uid }}-ghee)"/>
      <rect x="30" y="104" width="240" height="300" fill="url(#{{ uid }}-gheeside)"/>
      <g class="jar__grains">
        {%- for i in (1..54) -%}
          {%- liquid
            assign gx = i | times: 53 | modulo: 186 | plus: 58
            assign gy = i | times: 97 | modulo: 268 | plus: 116
            assign gr = i | modulo: 3 | times: 0.7 | plus: 0.9
            assign light = i | modulo: 2
          -%}
          <circle cx="{{ gx }}" cy="{{ gy }}" r="{{ gr }}" fill="{% if light == 0 %}#FFF4D2{% else %}#9C6A1E{% endif %}" opacity="{% if light == 0 %}.55{% else %}.28{% endif %}"/>
        {%- endfor -%}
      </g>
      <path class="jar__wave" fill="url(#{{ uid }}-surface)" d="M-200 104 q15 -7 30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 V 118 H -200 Z"/>
      <g class="jar__ripples" opacity="0">
        <ellipse class="jar__ripple" cx="150" cy="106" rx="20" ry="4.5" fill="none" stroke="#FFF6D8" stroke-width="2" opacity="0"/>
        <ellipse class="jar__ripple" cx="150" cy="106" rx="20" ry="4.5" fill="none" stroke="#FFF6D8" stroke-width="2" opacity="0"/>
      </g>
    </g>
  </g>

  {%- comment -%} front glass {%- endcomment -%}
  <rect x="64" y="122" width="11" height="222" rx="5.5" fill="#fff" opacity=".42"/>
  <rect x="81" y="132" width="4" height="120" rx="2" fill="#fff" opacity=".28"/>
  <rect x="229" y="124" width="8" height="226" rx="4" fill="#17120D" opacity=".07"/>
  <path d="M82 62 L82 80 C82 92 52 96 52 122 L52 352 C52 372 66 384 88 384 L212 384 C234 384 248 372 248 352 L248 122 C248 96 218 92 218 80 L218 62" fill="none" stroke="#17120D" stroke-opacity=".32" stroke-width="2"/>

  <g class="jar__label" clip-path="url(#{{ uid }}-labelclip)">
    <rect x="52" y="196" width="196" height="112" fill="#FBF7EE"/>
    <rect x="52" y="202" width="196" height="1.5" fill="#B8892F"/>
    <rect x="52" y="300" width="196" height="1.5" fill="#B8892F"/>
    <text class="jar__brand" x="150" y="230" text-anchor="middle">KARAKORAM NATURALS</text>
    <text class="jar__title" x="150" y="266" text-anchor="middle">{{ title }}</text>
    <text class="jar__sub" x="150" y="288" text-anchor="middle">{{ subtitle | upcase }}</text>
    <rect x="52" y="196" width="18" height="112" fill="#17120D" opacity=".06"/>
    <rect x="232" y="196" width="16" height="112" fill="#17120D" opacity=".09"/>
  </g>

  <g class="jar__lid">
    <rect x="70" y="22" width="160" height="42" rx="8" fill="url(#{{ uid }}-metal)"/>
    <rect x="66" y="16" width="168" height="12" rx="6" fill="url(#{{ uid }}-metal)"/>
    {%- for i in (0..17) -%}
      <rect x="{{ i | times: 8.4 | plus: 78 }}" y="32" width="1.6" height="26" fill="#5E400F" opacity=".25"/>
    {%- endfor -%}
    <rect x="70" y="58" width="160" height="6" rx="3" fill="#5E400F" opacity=".25"/>
  </g>
</g>
{%- endcapture -%}
{%- if as_group -%}
  {{ jar_body }}
{%- else -%}
  <svg class="jar jar--ghee" viewBox="0 0 300 400" role="img" aria-label="{{ title | escape }} jar" overflow="visible">{{ jar_body }}</svg>
{%- endif -%}
