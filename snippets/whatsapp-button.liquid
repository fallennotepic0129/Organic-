{%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' -%}
{%- if wa_number != blank -%}
  <a class="wa-float" href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp" data-magnetic>
    <span class="wa-float__pulse" aria-hidden="true"></span>
    {% render 'icon', name: 'whatsapp', size: 26 %}
  </a>
{%- endif -%}
