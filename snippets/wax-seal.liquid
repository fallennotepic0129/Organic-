{%- comment -%}
  Wax seal stamp used on certificates. Params: uid, text (ring text), mark (centre text), tone ('wax' | 'gold')
{%- endcomment -%}
{%- liquid
  assign uid = uid | default: 'seal'
  assign ring = text | default: 'VERIFIED · LAB TESTED · PURE · '
  assign mark = mark | default: 'MD'
  assign c1 = '#8E2626'
  assign c2 = '#5C1414'
  if tone == 'gold'
    assign c1 = '#D9A440'
    assign c2 = '#8C6420'
  endif
-%}
<svg class="seal" viewBox="0 0 120 120" aria-hidden="true">
  <defs>
    <radialGradient id="{{ uid }}-wax" cx=".38" cy=".32" r=".75">
      <stop offset="0" stop-color="{{ c1 }}"/>
      <stop offset="1" stop-color="{{ c2 }}"/>
    </radialGradient>
    <path id="{{ uid }}-ring" d="M60 60 m-36 0 a36 36 0 1 1 72 0 a36 36 0 1 1 -72 0"/>
  </defs>
  <circle cx="60" cy="60" r="50" fill="url(#{{ uid }}-wax)"/>
  <circle cx="60" cy="60" r="51" fill="none" stroke="url(#{{ uid }}-wax)" stroke-width="12" stroke-linecap="round" stroke-dasharray="0.1 12.2"/>
  <circle cx="60" cy="60" r="44" fill="none" stroke="#000" stroke-opacity=".25" stroke-width="1.5"/>
  <circle cx="60" cy="60" r="27" fill="none" stroke="#fff" stroke-opacity=".28" stroke-width="1"/>
  <text class="seal__ring" fill="#fff" fill-opacity=".85"><textPath href="#{{ uid }}-ring" startOffset="0">{{ ring }}{{ ring }}</textPath></text>
  <text class="seal__mark" x="60" y="68" text-anchor="middle" fill="#fff" fill-opacity=".92">{{ mark }}</text>
  <ellipse cx="44" cy="36" rx="14" ry="7" fill="#fff" opacity=".16" transform="rotate(-30 44 36)"/>
</svg>
